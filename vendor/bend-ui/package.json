{
  "name": "bend-ui",
  "version": "1.0.29",
  "description": "Design system in Bend: tokens in TOKENS.bend, rules in LAWS.bend.",
  "type": "module",
  "main": "ui.js",
  "exports": {
    ".": "./ui.js",
    "./agent": "./agent.js",
    "./thread": "./thread.js",
    "./ui.css": "./ui.css",
    "./TOKENS.bend": "./TOKENS.bend",
    "./MOTION.bend": "./MOTION.bend",
    "./brand/*": "./brand/*",
    "./keys": "./keys.js",
    "./KEYS.bend": "./KEYS.bend",
    "./SPEC.bend": "./SPEC.bend",
    "./syntax": "./syntax.js",
    "./SYNTAX.bend": "./SYNTAX.bend",
    "./diagram": "./diagram.js",
    "./DIAGRAM.bend": "./DIAGRAM.bend",
    "./chart": "./chart.js",
    "./CHART.bend": "./CHART.bend",
    "./MENU.bend": "./MENU.bend",
    "./workspace": "./workspace.js",
    "./workspace.css": "./workspace.css",
    "./WORKSPACE.bend": "./WORKSPACE.bend"
  },
  "files": [
    "ui.js",
    "ui.css",
    "icons.js",
    "agent.js",
    "thread.js",
    "keys.js",
    "syntax.js",
    "diagram.js",
    "chart.js",
    "TOKENS.bend",
    "MOTION.bend",
    "KEYS.bend",
    "SYNTAX.bend",
    "DIAGRAM.bend",
    "CHART.bend",
    "SPEC.bend",
    "LAWS.bend",
    "PROOF.bend",
    "MENU.bend",
    "brand",
    "ICONS-LICENSE",
    "docs",
    "workspace.js",
    "workspace.css",
    "WORKSPACE.bend",
    "WORKSPACE_LAWS.bend",
    "WORKSPACE_PROOF.bend"
  ],
  "scripts": {
    "check": "bend PROOF.bend",
    "docs": "bun docs/read-laws.js && cd docs && bun index.html",
    "site": "bun docs/read-laws.js && rm -rf site && bend docs/index.html -o site && cp docs/404.html site/404.html"
  }
}
